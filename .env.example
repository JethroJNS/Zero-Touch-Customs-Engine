# ============================================
# Zero-Touch Customs Engine - Environment Config
# ============================================
#
# COPY FILE INI MENJADI .env:
#   cp .env.example .env
#
# LALU EDIT VALUE SESUAI KEBUTUHAN
#
# ============================================

# ─── DATABASE CONFIGURATION ───────────────────────────────────────────────────
#
# UNTUK DOCKER COMPOSE (lokal):
#   DATABASE_URL=postgresql://postgres:postgres@db:5432/ocr_engine
#   (db adalah hostname service PostgreSQL di docker-compose.yml)
#
# UNTUK VPS HOSTINGER:
#   DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ocr_engine
#   (jika PostgreSQL jalan di host yang sama, gunakan localhost bukan db)
#
DATABASE_URL=postgresql://postgres:postgres@db:5432/ocr_engine

# ─── ML MODEL CONFIGURATION ─────────────────────────────────────────────────
#
# MODEL_REPO: HuggingFace repository ID untuk download model LayoutLMv3
#   - Model akan otomatis didownload saat startup/pertama kali diakses
#   - Size: ~480MB
#   - Repository: https://huggingface.co/iDelthea/zero-touch-customs-model
#
MODEL_REPO=iDelthea/zero-touch-customs-model

# MODEL_PATH (opsional): Path lokal ke model jika sudah ada
# MODEL_PATH=src/ml/models/layoutlmv3-v4/best_model

# DISABLE_LAYOUTXLM (opsional): Set ke 1 untuk skip LayoutLMv3
#   - Menggunakan text-based fallback saja
#   - Mengurangi RAM usage (~500MB lebih hemat)
#   - Akurasi mungkin berkurang untuk dokumen scanned
# DISABLE_LAYOUTXLM=1

# ─── POSTGRESQL (untuk VPS saja) ────────────────────────────────────────────
#
# Hanya diperlukan untuk VPS (bukan Docker Compose)
# Jika PostgreSQL berjalan di host yang sama dengan app:
#
# POSTGRES_DB=ocr_engine
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_secure_password

# ─── VISION API (opsional) ─────────────────────────────────────────────────
#
# Untuk enhanced extraction dengan Vision API
# VISION_API_KEY=your-api-key

# ─── CEISA 4.0 HOST-TO-HOST CONFIGURATION ─────────────────────────────────
#
# Environment CEISA:
#   - dev: Development/Testing (portal-dev.beacukai.go.id)
#   - prod: Production (portal.beacukai.go.id)
#
CEISA_ENV=dev

# API Credentials:
#   Daftar di https://portal-dev.beacukai.go.id (dev)
#   atau https://portal.beacukai.go.id (prod)
#
CEISA_USERNAME=your_username_here
CEISA_PASSWORD=your_password_here

# ─── CEISA PROD CONFIGURATION ───────────────────────────────────────────────
#
# Untuk production CEISA (Gunakan credential production):
# CEISA_ENV=prod
# CEISA_USERNAME=your_prod_username
# CEISA_PASSWORD=your_prod_password
